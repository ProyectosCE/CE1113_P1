#!/bin/sh

# Permite fijar el PCM desde /etc/default/aurabot-audio si fuese necesario.
[ -r /etc/default/aurabot-audio ] && . /etc/default/aurabot-audio

if [ -z "${AURABOT_AUDIO_DEVICE:-}" ]; then
    for card_id_file in /proc/asound/card*/id; do
        [ -r "$card_id_file" ] || continue
        card_id=$(cat "$card_id_file")
        case "$card_id" in
            *Headphones*|*headphones*)
                AURABOT_AUDIO_DEVICE="plughw:${card_id},0"
                break
                ;;
        esac
    done
fi

AURABOT_AUDIO_DEVICE=${AURABOT_AUDIO_DEVICE:-default}
export AURABOT_AUDIO_DEVICE

child_pid=""
stop_child() {
    [ -z "$child_pid" ] || kill "$child_pid" 2>/dev/null
    [ -z "$child_pid" ] || wait "$child_pid" 2>/dev/null
    exit 0
}
trap stop_child INT TERM

while :; do
    /usr/bin/aurabot-audio-server &
    child_pid=$!
    wait "$child_pid"
    result=$?
    child_pid=""
    logger -t aurabot-audio \
        "servidor terminó con código $result; reiniciando"
    sleep 2
done
