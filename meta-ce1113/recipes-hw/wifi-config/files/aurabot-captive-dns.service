[Unit]
Description=AuraBot captive DNS responder
After=aurabot-wifi.service
Requires=aurabot-wifi.service
PartOf=aurabot-wifi.service

[Service]
Type=simple
ExecStart=/usr/sbin/aurabot-captive-dns wlan0 192.168.4.1
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
