[Unit]
Description=AuraBot Wi-Fi DHCP client
After=aurabot-wifi.service
Requires=aurabot-wifi.service
Before=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
Environment=WIFI_INTERFACE=wlan0
EnvironmentFile=-/etc/default/aurabot-wifi
ExecStart=/sbin/udhcpc -f -i ${WIFI_INTERFACE} -p /run/udhcpc-${WIFI_INTERFACE}.pid
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
