[Unit]
Description=AuraBot access point DHCP server
After=aurabot-wifi.service
Requires=aurabot-wifi.service
Before=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/sbin/udhcpd -f /etc/aurabot/udhcpd.conf
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
