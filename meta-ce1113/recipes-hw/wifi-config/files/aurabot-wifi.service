[Unit]
Description=AuraBot Wi-Fi client
After=systemd-modules-load.service
Before=network-online.target aurabot-wifi-dhcp.service
Wants=aurabot-wifi-dhcp.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
Environment=WIFI_INTERFACE=wlan0
EnvironmentFile=-/etc/default/aurabot-wifi
ExecStartPre=/sbin/ip address flush dev ${WIFI_INTERFACE}
ExecStartPre=/sbin/ip link set ${WIFI_INTERFACE} up
ExecStart=/usr/sbin/wpa_supplicant -i ${WIFI_INTERFACE} -c /etc/wpa_supplicant/wpa_supplicant.conf
ExecStopPost=/sbin/ip address flush dev ${WIFI_INTERFACE}
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
