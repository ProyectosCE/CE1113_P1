#!/bin/sh
child_pid=""
failure_count=0
stop_child() {
    [ -z "$child_pid" ] || kill "$child_pid" 2>/dev/null
    [ -z "$child_pid" ] || wait "$child_pid" 2>/dev/null
    exit 0
}
trap stop_child INT TERM
while :; do
    started_at=$(date +%s)
    /usr/bin/aurabot &
    child_pid=$!
    wait "$child_pid"
    result=$?
    child_pid=""
    [ "$result" -eq 0 ] && exit 0
    finished_at=$(date +%s)
    if [ $((finished_at - started_at)) -ge 60 ]; then
        failure_count=0
    fi
    failure_count=$((failure_count + 1))
    if [ "$failure_count" -ge 5 ]; then
        logger -t aurabot "cinco fallos consecutivos; supervisor detenido"
        exit 1
    fi
    logger -t aurabot "servidor terminó con código $result; reiniciando"
    sleep $((failure_count * 2))
done
