#!/bin/sh

HTTPD_PID=""

stop_supervisor() {
    trap - TERM INT QUIT
    if [ -n "$HTTPD_PID" ] && kill -0 "$HTTPD_PID" 2>/dev/null; then
        kill "$HTTPD_PID" 2>/dev/null || true
        wait "$HTTPD_PID" 2>/dev/null || true
    fi
    exit 0
}

trap stop_supervisor TERM INT QUIT

while true; do
    # Equivale a "httpd -p 80 -h /www". Se añade -f para que el supervisor
    # pueda observar el proceso; el supervisor ya corre sin terminal.
    httpd -f -p 80 -h /www &
    HTTPD_PID=$!
    wait "$HTTPD_PID"
    RESULT=$?
    HTTPD_PID=""
    logger -t webapp-httpd "httpd terminó con código $RESULT; reiniciando"
    sleep 2
done
